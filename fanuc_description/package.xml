<package format="3">
  <name>fanuc_description</name>
  <version>1.1.1</version>
  <description>
    Standalone FANUC robot description package containing URDF, SRDF, and
    reference MoveIt configuration files. This package is ROS 2 distro-agnostic
    and can be used on Humble, Jazzy, or other ROS 2 distributions to load
    FANUC CRX robot models into the MoveIt Setup Assistant.
  </description>
  <license>Apache-2.0</license>
  <maintainer email="fanuc-ros-maintainer@fanuc.co.jp">FANUC CORPORATION</maintainer>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>fanuc_crx_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>urdf</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
